# ============ Producción — copiar a .env.production y completar ============

# Postgres (el contenedor crea el rol dueño + base con estos valores)
POSTGRES_USER=nexus_owner
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=nexus

# Conexiones de la app (host 'postgres' = nombre del servicio en compose)
DATABASE_URL=postgresql://nexus_app:nexus_app@postgres:5432/nexus?schema=public
DATABASE_MIGRATION_URL=postgresql://nexus_owner:CAMBIA_ESTA_CLAVE@postgres:5432/nexus?schema=public
DATABASE_RELAY_URL=postgresql://nexus_relay:nexus_relay@postgres:5432/nexus?schema=public

# JWT — generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=CAMBIA_ME_32_BYTES
JWT_REFRESH_SECRET=CAMBIA_ME_OTRO_32_BYTES

# RabbitMQ
RABBITMQ_USER=nexus
RABBITMQ_PASS=CAMBIA_ESTA_CLAVE
RABBITMQ_URL=amqp://nexus:CAMBIA_ESTA_CLAVE@rabbitmq:5672

# CORS / Frontend
WEB_ORIGIN=https://tudominio.com
# URL pública del API que usa el navegador (se hornea en el build del web)
NEXT_PUBLIC_API_URL=https://api.tudominio.com/api/v1

# Sembrar datos demo al primer arranque (poner false en prod real)
SEED_ON_START=true
