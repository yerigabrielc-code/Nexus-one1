// Nexus One — esquema multi-tenant (MVP).
// Toda tabla de negocio: tenantId + soft-delete + auditoría. Dinero = Decimal(18,4).
// El aislamiento real lo garantiza RLS (ver prisma/rls/001_enable_rls.sql), no Prisma.

generator client {
  provider      = "prisma-client-js"
  // 'native' para dev local; 'rhel-openssl-3.0.x' para el runtime serverless de Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_MIGRATION_URL") // migraciones con rol dueño
}

/// ───────────────────────── IDENTITY & TENANCY ─────────────────────────

enum TenantTier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum TenantIsolation {
  POOLED // shared schema + RLS
  SILOED // schema dedicado (Enterprise)
}

model Tenant {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  countryCode String          @default("DO") @db.Char(2)
  tier        TenantTier      @default(STARTER)
  isolation   TenantIsolation @default(POOLED)
  currency    String          @default("DOP") @db.Char(3)
  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  users       User[]
  customers   Customer[]

  @@map("tenant")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  email        String
  passwordHash String
  fullName     String
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roles        UserRole[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("role")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique // "<recurso>:<accion>"  ej. "customer:create"
  module String
  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

/// ───────────────────────── COMERCIAL / CRM ─────────────────────────

enum CustomerType {
  PROSPECT
  CUSTOMER
}

/// Tipo de identificación tributaria en RD (DGII).
enum TaxIdType {
  RNC    // Registro Nacional del Contribuyente (empresas)
  CEDULA // Personas físicas
  NONE
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Customer {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  code          String
  legalName     String
  tradeName     String?
  taxIdType     TaxIdType     @default(NONE)
  taxId         String? // RNC o Cédula
  type          CustomerType  @default(PROSPECT)
  email         String?
  phone         String?
  creditLimit   Decimal       @default(0) @db.Decimal(18, 4)
  isActive      Boolean       @default(true)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  contacts      Contact[]
  opportunities Opportunity[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, code])
  @@index([tenantId, legalName])
  @@index([tenantId, taxId])
  @@map("customer")
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  customerId String    @db.Uuid
  name       String
  role       String?
  email      String?
  phone      String?

  customer   Customer  @relation(fields: [customerId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([tenantId, customerId])
  @@map("contact")
}

model Opportunity {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  customerId  String           @db.Uuid
  title       String
  stage       OpportunityStage @default(NEW)
  amount      Decimal          @default(0) @db.Decimal(18, 4)
  ownerUserId String           @db.Uuid
  expectedAt  DateTime?

  customer    Customer         @relation(fields: [customerId], references: [id])

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, stage])
  @@index([tenantId, ownerUserId])
  @@map("opportunity")
}

/// ───────────────────────── INVENTARIO ─────────────────────────

enum CostingMethod {
  AVERAGE
  FIFO
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RESERVATION
  RELEASE
}

model Product {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  sku           String
  name          String
  unit          String           @default("UND")
  costingMethod CostingMethod    @default(AVERAGE)
  trackLots     Boolean          @default(false)
  trackSerials  Boolean          @default(false)
  basePrice     Decimal          @default(0) @db.Decimal(18, 4)
  isActive      Boolean          @default(true)

  stockItems    StockItem[]
  movements     StockMovement[]
  orderLines    SalesOrderLine[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("product")
}

model Warehouse {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  code       String
  name       String
  isActive   Boolean         @default(true)

  stockItems StockItem[]
  movements  StockMovement[]

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouse")
}

/// Saldo agregado (read model) — actualizado por eventos de movimiento.
model StockItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  productId   String    @db.Uuid
  warehouseId String    @db.Uuid
  onHand      Decimal   @default(0) @db.Decimal(18, 4)
  reserved    Decimal   @default(0) @db.Decimal(18, 4)
  avgCost     Decimal   @default(0) @db.Decimal(18, 4)

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId, warehouseId])
  @@map("stock_item")
}

/// Libro append-only = Kardex. Nunca update/delete. Particionable por (tenantId, createdAt).
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  productId       String            @db.Uuid
  warehouseId     String            @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(18, 4)
  unitCost        Decimal           @db.Decimal(18, 4)
  balanceAfter    Decimal           @db.Decimal(18, 4)
  refType         String?
  refId           String?           @db.Uuid
  lotCode         String?
  serialNumber    String?
  createdByUserId String            @db.Uuid

  product         Product           @relation(fields: [productId], references: [id])
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])

  createdAt       DateTime          @default(now())

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, refType, refId])
  @@map("stock_movement")
}

/// ───────────────────────── VENTAS ─────────────────────────

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  RESERVED
  INVOICED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
}

/// Estado del comprobante fiscal electrónico (e-CF) ante la DGII (RD, Ley 32-23).
enum FiscalStatus {
  NOT_APPLICABLE
  PENDING
  ACCEPTED
  REJECTED
}

model SalesOrder {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  number     String
  customerId String           @db.Uuid
  status     SalesOrderStatus @default(DRAFT)
  subtotal   Decimal          @default(0) @db.Decimal(18, 4)
  taxTotal   Decimal          @default(0) @db.Decimal(18, 4)
  total      Decimal          @default(0) @db.Decimal(18, 4)
  currency   String           @default("DOP") @db.Char(3)

  customer   Customer         @relation(fields: [customerId], references: [id])
  lines      SalesOrderLine[]
  invoice    Invoice?

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, customerId, status])
  @@map("sales_order")
}

model SalesOrderLine {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  salesOrderId String     @db.Uuid
  productId    String     @db.Uuid
  quantity     Decimal    @db.Decimal(18, 4)
  unitPrice    Decimal    @db.Decimal(18, 4)
  taxRate      Decimal    @default(0) @db.Decimal(6, 4) // ITBIS RD (18%) = 0.1800
  lineTotal    Decimal    @db.Decimal(18, 4)

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@index([tenantId, salesOrderId])
  @@map("sales_order_line")
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  number       String
  salesOrderId String?       @unique @db.Uuid
  customerId   String        @db.Uuid
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime?
  dueDate      DateTime?
  subtotal     Decimal       @default(0) @db.Decimal(18, 4)
  taxTotal     Decimal       @default(0) @db.Decimal(18, 4)
  total        Decimal       @default(0) @db.Decimal(18, 4)
  currency     String        @default("DOP") @db.Char(3)

  // ── Cumplimiento fiscal DGII (RD) ──
  ncfType      String? // tipo de comprobante: B01 (crédito fiscal), B02 (consumo), B04 (nota crédito)...
  ncf          String? // e-NCF asignado (secuencia electrónica)
  fiscalStatus FiscalStatus  @default(NOT_APPLICABLE)
  fiscalTrackId String? // TrackID devuelto por la DGII
  fiscalSecurityCode String? // código de seguridad del e-CF

  customer     Customer      @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  receivable   Receivable?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, number])
  @@unique([tenantId, ncf])
  @@index([tenantId, customerId, status])
  @@map("invoice")
}

/// ───────────────────────── COBROS / AR ─────────────────────────

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum PromiseStatus {
  PENDING
  KEPT
  BROKEN
}

model Receivable {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  invoiceId  String           @unique @db.Uuid
  customerId String           @db.Uuid
  amount     Decimal          @db.Decimal(18, 4)
  paidAmount Decimal          @default(0) @db.Decimal(18, 4)
  balance    Decimal          @db.Decimal(18, 4)
  dueDate    DateTime
  status     ReceivableStatus @default(OPEN)

  invoice    Invoice          @relation(fields: [invoiceId], references: [id])
  payments   Payment[]
  promises   PaymentPromise[]

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([tenantId, customerId, status])
  @@index([tenantId, dueDate]) // aging
  @@map("receivable")
}

model Payment {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  receivableId       String     @db.Uuid
  amount             Decimal    @db.Decimal(18, 4)
  method             String
  paidAt             DateTime   @default(now())
  registeredByUserId String     @db.Uuid

  receivable         Receivable @relation(fields: [receivableId], references: [id])

  createdAt          DateTime   @default(now())

  @@index([tenantId, receivableId])
  @@map("payment")
}

model PaymentPromise {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  receivableId    String        @db.Uuid
  promisedAmount  Decimal       @db.Decimal(18, 4)
  promisedDate    DateTime
  status          PromiseStatus @default(PENDING)
  note            String?
  createdByUserId String        @db.Uuid

  receivable      Receivable    @relation(fields: [receivableId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId, status, promisedDate])
  @@map("payment_promise")
}

/// ───────────────────────── INFRA: OUTBOX + AUDIT ─────────────────────────

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  eventType     String
  eventVersion  Int       @default(1)
  aggregateType String
  aggregateId   String    @db.Uuid
  correlationId String?   @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)

  @@index([processedAt, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_event")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String   @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/// ═════════════════════════ FASE 2: COMPRAS ═════════════════════════

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  code       String
  legalName  String
  taxIdType  TaxIdType       @default(NONE)
  taxId      String?
  email      String?
  phone      String?
  rating     Int             @default(0) // evaluación 0-5
  isActive   Boolean         @default(true)

  orders     PurchaseOrder[]

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  @@unique([tenantId, code])
  @@index([tenantId, legalName])
  @@map("supplier")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  number      String
  supplierId  String              @db.Uuid
  warehouseId String              @db.Uuid // destino de la recepción
  status      PurchaseOrderStatus @default(DRAFT)
  subtotal    Decimal             @default(0) @db.Decimal(18, 4)
  taxTotal    Decimal             @default(0) @db.Decimal(18, 4)
  total       Decimal             @default(0) @db.Decimal(18, 4)
  currency    String              @default("DOP") @db.Char(3)

  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  lines       PurchaseOrderLine[]
  receipts    GoodsReceipt[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, supplierId, status])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  productId       String        @db.Uuid
  quantity        Decimal       @db.Decimal(18, 4)
  unitCost        Decimal       @db.Decimal(18, 4)
  taxRate         Decimal       @default(0) @db.Decimal(6, 4)
  lineTotal       Decimal       @db.Decimal(18, 4)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_line")
}

model GoodsReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  number          String
  purchaseOrderId String        @db.Uuid
  receivedAt      DateTime      @default(now())
  receivedByUserId String       @db.Uuid

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  createdAt       DateTime      @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipt")
}

/// ═════════════════════════ FASE 2: PAGOS (AP) ═════════════════════════

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Payable {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  supplierId      String           @db.Uuid
  purchaseOrderId String?          @db.Uuid
  supplierInvoice String? // número de factura del proveedor (NCF de compra)
  amount          Decimal          @db.Decimal(18, 4)
  paidAmount      Decimal          @default(0) @db.Decimal(18, 4)
  balance         Decimal          @db.Decimal(18, 4)
  dueDate         DateTime
  status          PayableStatus    @default(OPEN)

  payments        SupplierPayment[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId, supplierId, status])
  @@index([tenantId, dueDate])
  @@map("payable")
}

model SupplierPayment {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  payableId          String   @db.Uuid
  amount             Decimal  @db.Decimal(18, 4)
  method             String
  paidAt             DateTime @default(now())
  registeredByUserId String   @db.Uuid

  payable            Payable  @relation(fields: [payableId], references: [id])

  createdAt          DateTime @default(now())

  @@index([tenantId, payableId])
  @@map("supplier_payment")
}

/// ═════════════════════════ FASE 2: DOCUMENTAL ═════════════════════════

model Document {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  groupId         String   @db.Uuid // agrupa versiones del mismo documento lógico
  name            String
  mimeType        String
  sizeBytes       Int      @default(0)
  storageKey      String // clave en S3-compatible
  version         Int      @default(1)
  entityType      String? // vínculo polimórfico: "Invoice","Customer","Asset"...
  entityId        String?  @db.Uuid
  uploadedByUserId String  @db.Uuid

  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  @@index([tenantId, groupId, version])
  @@index([tenantId, entityType, entityId])
  @@map("document")
}

/// ═════════════════════════ FASE 2: AUTOMATIZACIÓN ═════════════════════════

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model AutomationRule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  eventType String // evento de dominio que dispara la regla
  condition Json? // condición evaluable
  action    Json // acción a ejecutar (notificar, escalar, etc.)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, eventType, isActive])
  @@map("automation_rule")
}

model Alert {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  type       String
  message    String
  entityType String?
  entityId   String?  @db.Uuid
  targetUserId String? @db.Uuid
  isRead     Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@index([tenantId, targetUserId, isRead])
  @@map("alert")
}

model Approval {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  entityType      String // "PurchaseOrder","SupplierPayment"...
  entityId        String         @db.Uuid
  status          ApprovalStatus @default(PENDING)
  requestedByUserId String       @db.Uuid
  decidedByUserId String?        @db.Uuid
  note            String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
  @@map("approval")
}

/// ═════════════════════════ FASE 3: ACTIVOS Y MANTENIMIENTO ═════════════════════════

enum AssetStatus {
  ACTIVE
  IN_MAINTENANCE
  RETIRED
}

enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Asset {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  code       String
  name       String
  category   String?
  location   String?
  status     AssetStatus  @default(ACTIVE)
  acquiredAt DateTime?

  workOrders WorkOrder[]
  plans      MaintenancePlan[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("asset")
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  number           String
  assetId          String          @db.Uuid
  type             WorkOrderType
  status           WorkOrderStatus @default(OPEN)
  description      String?
  scheduledAt      DateTime?
  completedAt      DateTime?
  assignedToUserId String?         @db.Uuid

  asset            Asset           @relation(fields: [assetId], references: [id])
  checklist        ChecklistItem[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, assetId, status])
  @@map("work_order")
}

model ChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  workOrderId String    @db.Uuid
  description String
  done        Boolean   @default(false)
  note        String?

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, workOrderId])
  @@map("checklist_item")
}

model MaintenancePlan {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  assetId       String   @db.Uuid
  name          String
  frequencyDays Int
  nextDueAt     DateTime
  isActive      Boolean  @default(true)

  asset         Asset    @relation(fields: [assetId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, nextDueAt, isActive])
  @@map("maintenance_plan")
}
