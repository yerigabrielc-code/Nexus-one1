# ── Base de datos ──────────────────────────────────────────────
# Rol de APLICACIÓN: SIN privilegio de bypass de RLS (defensa en profundidad)
DATABASE_URL="postgresql://nexus_app:nexus_app@localhost:5432/nexus?schema=public"
# Rol de MIGRACIONES: dueño del schema, puede alterar tablas y aplicar RLS
DATABASE_MIGRATION_URL="postgresql://nexus_owner:nexus_owner@localhost:5432/nexus?schema=public"
# Rol del RELAY de Outbox: BYPASSRLS (lee eventos de todos los tenants). Solo el worker relay.
DATABASE_RELAY_URL="postgresql://nexus_relay:nexus_relay@localhost:5432/nexus?schema=public"

# ── Auth ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900"          # 15 min en segundos
JWT_REFRESH_TTL="2592000"     # 30 días en segundos

# ── Infra ──────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://nexus:nexus@localhost:5672"

# ── App ────────────────────────────────────────────────────────
API_PORT="3001"
NODE_ENV="development"

# ── Fiscal (País #1: República Dominicana - DGII) ──────────────
FISCAL_COUNTRY="DO"
FISCAL_DEFAULT_CURRENCY="DOP"
